NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:5173

# Supabase (copy real keys into a local .env, do NOT commit secrets)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# SESSION_SECRET must be a long random string (32+ chars) in production
SESSION_SECRET=replace_with_a_long_random_secret_at_least_32_chars
SESSION_NAME=interviewai.sid
SESSION_TTL_HOURS=24

# OpenAI (AI interviews, speech-to-text, feedback reports). Leave empty to use built-in fallbacks.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_WHISPER_MODEL=whisper-1

MAX_UPLOAD_MB=10
UPLOAD_DIR=storage/uploads
